# Copiar como .env y completar con valores propios. Nunca subir .env al repositorio.
# Las variables se finalizan en la Etapa 2; el ID del modelo se confirma en la Etapa 3.

# --- LLM de ejecución (Gemini, capa gratuita) ---
# Clave gratuita de Google AI Studio (sin tarjeta). Ver docs/setup_llm.md.
GEMINI_API_KEY=
# ID exacto del modelo Gemini Flash. PENDIENTE: se confirma en la Etapa 3.
LLM_MODEL=
# Reintentos ante HTTP 429 / RESOURCE_EXHAUSTED.
LLM_MAX_RETRIES=5
# Pausa mínima entre llamadas, en segundos, para respetar los límites gratuitos.
LLM_MIN_SECONDS_BETWEEN_CALLS=4

# --- Google Drive y Sheets (cuenta de servicio) ---
# Ruta local al JSON de la cuenta de servicio. Ver docs/setup_google.md.
GOOGLE_APPLICATION_CREDENTIALS=
# ID de la carpeta de Drive de prueba, compartida con la cuenta de servicio.
DRIVE_FOLDER_ID=
# ID de la planilla de Google Sheets de prueba, compartida con la cuenta de servicio.
SHEET_ID=

# --- Demo Telegram (opcional, no se usa en el notebook) ---
# Token del bot creado con BotFather. Ver docs/setup_telegram.md.
TELEGRAM_BOT_TOKEN=
